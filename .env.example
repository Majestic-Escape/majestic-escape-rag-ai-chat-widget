# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit it.

# ─── Required ─────────────────────────────────────────────────────────────────

# Gemini Developer API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# MongoDB Atlas connection string. Must include the database name in the path
# (e.g. mongodb+srv://user:pass@cluster.mongodb.net/master-db?retryWrites=true&w=majority)
MONGODB_URI=

# JWT signing key. MUST match the value used by server.me so logged-in users
# on majesticescape.in are trusted by this service without a separate auth flow.
JWT_SECRET=

# ─── Recommended (resilience) ─────────────────────────────────────────────────

# Second model provider. A turn makes at most two model attempts: the primary,
# then this one, on ANY failure (see CLAUDE.md "AI provider fallback chain").
# Without it there is no fallback.
GROQ_API_KEY=

# ─── Search assistant (src/lib/rag) ───────────────────────────────────────────

# safe   = fixed "use site search / Support" reply, no model call  (default, and the rollback target)
# shadow = customers get `safe`; the new pipeline runs silently and only logs
# v2     = the new pipeline answers
RAG_PIPELINE=safe
# With RAG_PIPELINE=v2: percentage of identities that get v2 (the rest get `safe`).
RAG_V2_PERCENT=100
# filters (default) = guests set the search with filter buttons; a typed message is never applied by itself
# chat              = the model's reading is applied directly (held to the 98 % / 95 % gates; not met)
RAG_SEARCH_MODE=filters
# Filters mode: on = a typed message becomes a draft the guest confirms (needs a model); off (default) = buttons only.
# Production: on, for every visitor, with Claude Haiku 5.5 (LLM_CHAIN below). Rollback: off (a redeploy, ~2 min);
# the filter buttons keep working either way. The admin AI switch is not a drafting switch: it closes the filters too.
RAG_AI_DRAFT=off
# on = dates are sent to the search. Keep off until the server.me A9 fix (search vs booking) is live.
RAG_DATED_SEARCH=off

# Claude (Anthropic, paid, prepaid credits with auto-reload off). Used only by chain entries `anthropic:<model>`.
# The instructions (~2,000 tokens) are prompt-cached: a hit reads them at 0.1x the input price for 5 minutes.
# Out of credit or over a spend limit (402 billing_error, or a 429 with error_code *_spend_limit_reached): drafting
# pauses 10 minutes (typed messages get "use the filter buttons" at once, no calls); after a refill the first typed
# message past the pause reaches Claude again. No restart or flag change. The log says "[llm] … paused 10 min".
ANTHROPIC_API_KEY=

# server.me's public API — the single source of stays, places and date availability.
CATALOG_API_URL=https://server.majesticescape.in/api/v1

# Model ids. Never hard-code one: providers retire models (every id this service
# first shipped with is gone). Re-run `npm run eval:rag -- --live` after a change.
# Ordered list, `provider:model`, comma-separated. At most 2 attempts per message;
# a model that answers 429 / 401 / 404 or keeps failing is skipped for a while
# (circuit breaker). Only these models are ever called. Both unset = the code default,
# the proposed production routing: English Groq gpt-oss-120b then qwen3.8-27b, Hindi /
# Hinglish qwen3.8-27b then gpt-oss-120b. Gemini's unpaid tier allows human review of
# inputs: do not add it for customer traffic without a paid key.
# Production (2026-11-28): Claude Haiku 5.5 only, for every language.
LLM_CHAIN=anthropic:claude-haiku-5-5
# A second chain for Hindi / Hinglish messages (Devanagari, or a word such as "mein",
# "chahiye", "tak"). Same rules: at most 2 attempts, only these models. With LLM_CHAIN set
# and this unset, every message uses LLM_CHAIN. Production leaves it UNSET, so Hindi and
# Hinglish also go to Haiku only; setting it would route them to another provider.
# LLM_CHAIN_HINGLISH=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b

# Hard ceiling on model attempts per day (India time), all customers together.
# Kept in MongoDB (`ai_usage`), so restarts and extra instances cannot reset it.
# Haiku drafts for everyone: 1000 ≈ at most $0.40 a day ($0.0001 with a cache hit to $0.0004 with a miss per call).
# The `ai_usage` row per day also counts answered `calls` and `cacheRead` / `cacheWrite` tokens, for exact spend.
DAILY_AI_LIMIT_GLOBAL=1000

# ─── Admin allow-list (optional emergency overrides only) ────────────────────
# The chatbot determines admin status by looking up the JWT's `userId` in the
# `admins` collection (server.me/models/Admin.js). A non-banned record with
# role: "admin" is treated as admin — no env-var maintenance needed.
# These two vars exist as emergency overrides (e.g. local dev without a DB,
# or to grant temporary admin access without touching the DB). Leave blank
# in production unless you have a specific override use case.

ADMIN_EMAILS=
ADMIN_USER_IDS=

# ─── Cost guardrails ──────────────────────────────────────────────────────────
# Daily soft caps on TYPED /api/chat messages that reach a model (in memory: reset on restart).
# A typed message reserves one up front and gives it back when no model was asked (the model
# resting after a billing / rate-limit error, drafting off, a message the code reads itself,
# a safe reply, a refused or invalid request); the per-minute limits still count every message.
# Filter buttons, "Start fresh" and quick answers never call a model and are not counted (their
# own per-minute limit protects the search API). Per signed-in person, per guest device, and per
# network (higher: many phones share one address through carrier NAT; it is the abuse backstop).
DAILY_AI_LIMIT_USER=10
DAILY_AI_LIMIT_GUEST=10
DAILY_AI_LIMIT_IP=30

# ─── Networking ───────────────────────────────────────────────────────────────

# Comma-separated browser origins allowed to connect (Socket.IO + /api/chat).
ALLOWED_ORIGINS=https://majesticescape.in,https://admin.majesticescape.in,http://localhost:3000,http://localhost:3001

# Where the chat widget links property cards to. Production: https://majesticescape.in
NEXT_PUBLIC_PROPERTY_BASE_URL=https://majesticescape.in

# Socket.IO endpoint for the user.website chat widget. Leave empty in
# production to use window.location.origin; set to http://localhost:3003
# in dev when running this service alongside user.website on different ports.
NEXT_PUBLIC_SUPPORT_SOCKET_URL=

# Local dev port. Railway injects PORT automatically — do NOT set it on Railway.
PORT=3003
